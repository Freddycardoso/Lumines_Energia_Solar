---
import Layout from '../layouts/Layout.astro';
import CalculadoraSolar from '../components/CalculadoraSolar.jsx';
import { Image } from 'astro:assets';

import imgHero from '../assets/hero-usina-colinas.jpg';
import imgTecnica from '../assets/tecnica-fixacao-telhado.jpg';
import imgRural from '../assets/rural-usina-solo.jpg';
import imgSede from '../assets/sede-lumines-passos.jpg';
import imgInterior from '../assets/interior-lumines.png';
---

<Layout
  title="Lumines Energia Solar | Engenharia Fotovoltaica em Passos - MG"
  description="Reduza até 95% do custo com energia elétrica em sua empresa, indústria ou propriedade rural. Projetos homologados, instalação de alta performance e garantia em Passos e região."
>
  <main class="w-full flex flex-col overflow-x-hidden">
    
    <!-- HERO SECTION -->
    <section id="hero" class="relative w-full overflow-hidden flex flex-col min-h-screen z-20 bg-[#162C5B]">
        
        <!-- IMAGEM DE FUNDO E GRADIENTE ATMOSFÉRICO -->
        <div class="absolute inset-0 z-0">
          <Image
            src={imgHero}
            alt="Usina fotovoltaica de solo instalada em relevo montanhoso regional"
            class="w-full h-full object-cover scale-105"
            fetchpriority="high"
            loading="eager"
          />
          <!-- Camadas de Gradiente e Contraste (Azul Lumines) -->
          <div class="absolute inset-0 bg-gradient-to-br from-[#0E1E3E] via-[#162C5B]/70 to-transparent mix-blend-multiply"></div>
          <div class="absolute inset-0 bg-gradient-to-t from-[#0E1E3E]/95 via-[#162C5B]/30 to-[#162C5B]/20"></div>
        </div>

        <!-- HEADER TRANSLÚCIDO E FIXO (Apple-style) -->
        <header class="fixed top-0 left-0 right-0 z-50 py-4 px-6 sm:px-12 lg:px-16 flex items-center justify-between bg-[#162C5B]/70 backdrop-blur-[24px] saturate-[1.5] border-b border-white/[0.08]">
          <div class="flex items-center gap-3">
            <svg class="w-7 h-7 text-white" viewBox="0 0 24 24" fill="currentColor">
               <path d="M12 2L15 8H21L16 12L18 18L12 15L6 18L8 12L3 8H9L12 2Z" />
            </svg>
            <span class="text-2xl font-semibold tracking-tight text-white">Lumines</span>
          </div>
          <nav class="hidden lg:flex items-center gap-10 text-sm font-medium text-white/80">
            <a href="#solucoes" class="hover:text-white transition-colors">Soluções</a>
            <a href="#calculadora" class="hover:text-white transition-colors">Simulador</a>
            <a href="#engenharia" class="hover:text-white transition-colors">Engenharia</a>
            <a href="#empresa" class="hover:text-white transition-colors">Sede</a>
          </nav>
          <a
            href="https://wa.me/5535999765975"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 bg-white/10 hover:bg-white/20 backdrop-blur-md border border-white/20 text-white text-xs sm:text-sm font-medium py-2.5 px-5 rounded-full premium-interactive"
          >
            Falar com Especialista
            <span class="bg-white text-neutral-900 rounded-full p-1.5 flex items-center justify-center">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </span>
          </a>
        </header>

        <!-- CONTEÚDO PRINCIPAL (HERO) -->
        <main class="relative z-10 flex-1 flex flex-col justify-center px-6 sm:px-12 lg:px-20 pt-32 pb-10">
          <div class="max-w-5xl">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 backdrop-blur-md border border-white/10 text-white text-xs sm:text-sm font-medium tracking-wide mb-8 shadow-sm">
              <span class="text-amber-400">⚡</span>
              <span>ENGENHARIA FOTOVOLTAICA HOMOLOGADA</span>
            </div>
            <h1 class="text-4xl sm:text-6xl lg:text-7xl font-medium text-white tracking-tighter leading-[1.05] mb-8 drop-shadow-sm">
              Reduza até 95% da conta de luz e blinde seu patrimônio contra os aumentos da concessionária.
            </h1>
            <p class="text-lg sm:text-xl text-white/80 mb-10 max-w-3xl font-light leading-relaxed">
              Projetos de engenharia fotovoltaica de alto rendimento para agronegócio, empresas e residências em Passos e todo o Sudoeste Mineiro.
            </p>
            <div class="flex flex-col sm:flex-row items-center gap-4">
              <a
                href="#calculadora"
                class="inline-flex items-center gap-3 bg-orange-500 hover:bg-orange-600 text-white pl-7 pr-2.5 py-2.5 rounded-full font-bold premium-interactive shadow-lg shadow-orange-500/30"
              >
                Simular Economia no WhatsApp
                <span class="bg-neutral-950 text-white rounded-full p-2.5 flex items-center justify-center">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </span>
              </a>
            </div>
          </div>
        </main>

        <!-- CARTÕES DE IMPACTO (GLASSMORPHISM) -->
        <div class="relative z-20 w-full px-6 sm:px-12 lg:px-20 pb-12 mt-auto pt-16">
          <div class="flex flex-col lg:flex-row gap-6">
            <div class="flex-1 bg-white/5 hover:bg-white/10 backdrop-blur-xl border border-white/10 border-t-white/30 rounded-[2rem] p-8 text-white shadow-[0_8px_32px_0_rgba(0,0,0,0.36)] transition-all">
              <div class="flex items-center gap-3 mb-6">
                 <div class="bg-white text-neutral-900 rounded-full p-2">
                   <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M13 2L3 14H12L11 22L21 10H12L13 2Z"/>
                   </svg>
                 </div>
                 <span class="text-sm font-medium text-white/90">Redução de Custo</span>
              </div>
              <h3 class="text-4xl sm:text-5xl font-semibold mb-3 tracking-tight">95%</h3>
              <p class="text-sm text-white/70 font-light leading-relaxed">
                Blindagem financeira total e retorno acelerado do investimento.
              </p>
            </div>
            
            <div class="flex-1 bg-white/5 hover:bg-white/10 backdrop-blur-xl border border-white/10 border-t-white/30 rounded-[2rem] p-8 text-white shadow-[0_8px_32px_0_rgba(0,0,0,0.36)] transition-all">
              <div class="flex items-center gap-3 mb-6">
                 <div class="bg-white text-neutral-900 rounded-full p-2">
                   <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                   </svg>
                 </div>
                 <span class="text-sm font-medium text-white/90">Garantia Estrutural</span>
              </div>
              <h3 class="text-4xl sm:text-5xl font-semibold mb-3 tracking-tight">25 Anos</h3>
              <p class="text-sm text-white/70 font-light leading-relaxed">
                Durabilidade linear comprovada. Equipamentos premium homologados.
              </p>
            </div>

            <div class="flex-1 bg-white/5 hover:bg-white/10 backdrop-blur-xl border border-white/10 border-t-white/30 rounded-[2rem] p-8 text-white shadow-[0_8px_32px_0_rgba(0,0,0,0.36)] transition-all">
              <div class="flex items-center gap-3 mb-6">
                 <div class="bg-white text-neutral-900 rounded-full p-2">
                   <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                   </svg>
                 </div>
                 <span class="text-sm font-medium text-white/90">Gestão Completa</span>
              </div>
              <h3 class="text-4xl sm:text-5xl font-semibold mb-3 tracking-tight">100%</h3>
              <p class="text-sm text-white/70 font-light leading-relaxed">
                Trâmite regulatório na concessionária integralmente conduzido pela nossa engenharia.
              </p>
            </div>
          </div>
        </div>

      <!-- Divisor Curvo Orgânico na Base da Hero -->
      <div class="relative w-full overflow-hidden leading-none z-20 -mb-1 mt-auto">
        <svg 
          class="relative block w-full h-[60px] sm:h-[90px] lg:h-[130px]" 
          viewBox="0 0 1440 120" 
          fill="none" 
          xmlns="http://www.w3.org/2000/svg"
          preserveAspectRatio="none"
        >
          <path 
            d="M0,0 C480,100 960,100 1440,0 L1440,120 L0,120 Z" 
            class="fill-slate-50"
          />
        </svg>
      </div>
    </section>

      <!-- SEÇÃO CALCULADORA (BRANCO / OFF-WHITE) -->
      <section id="calculadora" class="relative py-24 w-full z-20 bg-slate-50">
        <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center mb-16">
          <h2 class="text-4xl sm:text-5xl font-semibold text-slate-900 tracking-tight mb-6">
            Projete o Futuro do seu Caixa
          </h2>
          <p class="text-lg text-slate-600 font-light max-w-2xl mx-auto">
            Utilize nossa calculadora inteligente para projetar sua economia anual estimada antes de falar com nossos engenheiros.
          </p>
        </div>

        <div class="relative z-10 -mt-4 mb-32">
          <!-- Calculadora Renderizada (Ilha React) -->
          <CalculadoraSolar client:visible />
        </div>

        <!-- Divisor Curvo Orgânico (Curva para cima) na Base da Calculadora -->
        <div class="absolute bottom-0 left-0 w-full overflow-hidden leading-none z-20 translate-y-[1px]">
          <svg 
            class="relative block w-full h-[60px] sm:h-[90px] lg:h-[130px]" 
            viewBox="0 0 1440 120" 
            fill="none" 
            xmlns="http://www.w3.org/2000/svg"
            preserveAspectRatio="none"
          >
            <path 
              d="M0,120 C480,0 960,0 1440,120 Z" 
              class="fill-[#162C5B]"
            />
          </svg>
        </div>
      </section>

      <!-- SEÇÃO ENGENHARIA (AZUL INSTITUCIONAL COM VIDRO) -->
      <section id="engenharia" class="relative pt-32 pb-48 w-full bg-[#162C5B]">
        <!-- Background Imersivo com Fade Nítido -->
        <div class="absolute inset-0 z-0">
          <Image
            src={imgTecnica}
            alt="Detalhes técnicos de instalação"
            class="w-full h-full object-cover object-right"
          />
          <!-- Máscara de Gradiente: Escuro na esquerda (onde fica o texto), Transparente na direita (onde a foto brilha) -->
          <div class="absolute inset-0 bg-gradient-to-r from-[#162C5B] via-[#162C5B]/80 to-transparent"></div>
          
          <!-- Suavização do topo (48px de transição rápida) para fundir perfeitamente com a curva SVG -->
          <div class="absolute top-0 left-0 w-full h-48 bg-gradient-to-b from-[#162C5B] from-10% via-[#162C5B]/80 to-transparent"></div>
          
          <!-- Suavização da base -->
          <div class="absolute bottom-0 left-0 w-full h-48 bg-gradient-to-t from-[#162C5B] via-[#162C5B]/80 to-transparent"></div>
        </div>

        <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center">
          <!-- Bloco Assimétrico à Esquerda -->
          <div class="md:w-3/5 lg:w-1/2">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold tracking-wide mb-6 uppercase">
              Rigor Mecânico e Elétrico
            </div>
            <h2 class="text-4xl sm:text-5xl font-semibold text-white tracking-tight leading-tight mb-8 drop-shadow-lg">
              Instalações sem atalhos operacionais ou danos estruturais.
            </h2>
            
            <!-- Cards Flutuantes Empilhados -->
            <div class="space-y-6 relative">
              <div class="bg-white/10 backdrop-blur-md border border-white/15 rounded-2xl p-6 shadow-2xl relative z-20 text-white">
                <h3 class="text-xl font-medium text-white mb-3">Perfis de Alumínio e Fixação Específica</h3>
                <p class="text-white/80 font-light leading-relaxed">
                  Utilização exclusiva de grampos intermediários e terminais de liga nobre. Fixação milimétrica que previne microfissuras nas células de silício e impede infiltrações no telhado.
                </p>
              </div>
              
              <div class="bg-white/10 backdrop-blur-md border border-white/15 rounded-2xl p-6 shadow-2xl relative z-10 translate-x-4 sm:translate-x-8 -translate-y-4 text-white">
                <h3 class="text-xl font-medium text-white mb-3">Conformidade com NR-10 e NR-35</h3>
                <p class="text-white/80 font-light leading-relaxed">
                  Segurança de trabalho em altura e instalações elétricas industriais. String boxes com dispositivos de proteção contra surtos (DPS) e fusíveis dedicados.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- SEÇÃO AGRONEGÓCIO (ASSIMETRIA OPOSTA) -->
      <section id="solucoes" class="relative pt-32 pb-48 w-full bg-[#0E1E3E]">
        <!-- Background Imersivo com Fade Nítido Reverso -->
        <div class="absolute inset-0 z-0">
          <Image
            src={imgRural}
            alt="Usina de solo no agronegócio"
            class="w-full h-full object-cover object-left"
          />
          <!-- Máscara de Gradiente: Escuro na direita (onde fica o texto), Transparente na esquerda (onde a foto brilha) -->
          <div class="absolute inset-0 bg-gradient-to-l from-[#0E1E3E] via-[#0E1E3E]/80 to-transparent"></div>
          <!-- Suavização do topo e base -->
          <div class="absolute inset-0 bg-gradient-to-t from-[#0E1E3E] via-transparent to-[#0E1E3E]/80"></div>
        </div>

        <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row justify-end items-center">
          <!-- Bloco Assimétrico à Direita -->
          <div class="md:w-3/5 lg:w-1/2">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-400 text-xs font-semibold tracking-wide mb-6 uppercase">
              Agronegócio e Indústria
            </div>
            <h2 class="text-4xl sm:text-5xl font-semibold text-white tracking-tight leading-tight mb-8 drop-shadow-lg">
              Usinas de solo dimensionadas para altíssima demanda.
            </h2>
            <p class="text-lg text-white/70 mb-10 font-light leading-relaxed">
              No agronegócio de Passos e região — da cafeicultura aos confinamentos pecuários e sistemas de irrigação —, blindar o custo energético é fator determinante de lucro.
            </p>
            
            <div class="bg-white/5 backdrop-blur-xl border border-white/10 border-l-amber-500/50 rounded-3xl p-8 shadow-2xl relative -translate-x-4 sm:-translate-x-12">
              <h3 class="text-xl font-medium text-white mb-3">Engenharia Rural Especializada</h3>
              <p class="text-white/60 font-light leading-relaxed">
                Cálculo de ancoragem de solo com fundações adequadas à topografia da região, proteção contra sombreamento e roteamento de cabos subterrâneos blindados para segurança máxima de operação.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- SEÇÃO DE PROVA SOCIAL E TESTEMUNHOS -->
      <section id="testemunhos" class="relative py-24 w-full bg-slate-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          
          <!-- Cabeçalho da Seção -->
          <div class="text-center max-w-3xl mx-auto mb-16">
            <h2 class="text-4xl sm:text-5xl font-semibold text-slate-900 tracking-tight mb-6">
              A Confiança de Quem Já Economiza na Prática
            </h2>
            <div class="flex flex-col sm:flex-row items-center justify-center gap-4 text-slate-600">
              <div class="flex items-center gap-2 bg-white px-4 py-2 rounded-full shadow-sm border border-slate-200">
                <!-- SVG Simples do 'G' do Google -->
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                  <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                  <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                  <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                </svg>
                <span class="font-bold text-slate-900 text-lg">4.9/5.0</span>
                <div class="flex gap-0.5 text-[#FBBF24]">
                  <!-- 5 Estrelas -->
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                </div>
              </div>
              <span class="text-sm font-medium">Avaliado por mais de 45 clientes reais em Passos e região</span>
            </div>
          </div>

          <!-- Grelha de Testemunhos -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            
            <!-- Card 1 -->
            <div class="bg-white rounded-2xl p-6 shadow-[0_4px_20px_-4px_rgba(0,0,0,0.05)] border border-slate-200 flex flex-col justify-between premium-hover reveal-on-scroll">
              <div>
                <div class="flex items-center gap-1 mb-4 text-[#FBBF24]">
